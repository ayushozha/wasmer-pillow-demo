From 3289c492310ead5857137d0e5139b17ebf2e016f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 23 Oct 2026 02:01:35 +0000
Subject: [PATCH] add Wasmer Edge deploy option

---
 Anybuild  | 21 +++++++++++++++++++++
 README.md |  6 ++++++
 2 files changed, 27 insertions(+)
 create mode 100644 Anybuild

diff --git a/Anybuild b/Anybuild
new file mode 100644
index 0000000..cf42be6
--- /dev/null
+++ b/Anybuild
@@ -0,0 +1,21 @@
+# Generated by Anybuild v0.33.1 — https://anybuild.run
+# This file is yours to edit: add steps or override the serve below.
+
+load("//anybuild/tools:node_static.bzl", "nodestatic_build", "nodestatic_config", "nodestatic_serve")
+
+config = nodestatic_config(
+    schema = 1,
+    sws_version = "2.38.0",
+    static_dir = "dist",
+    node_package_manager = "yarn",
+    node_framework = "vite",
+    node_server = "node",
+    node_version = "24",
+    # yarn 4 reads .yarnrc.yml (nodeLinker, yarnPath) during install,
+    # so install with all source files present
+    node_install_requires_all_files = True,
+)
+
+build = nodestatic_build(config)
+
+nodestatic_serve(config, build, name = "pgtune")
diff --git a/README.md b/README.md
index 23293e5..2c0afa0 100644
--- a/README.md
+++ b/README.md
@@ -35,6 +35,12 @@ Generated configurations for representative inputs are stored in `src/features/c
 $ yarn test -u
 ```
 
+## Deploy
+
+[![Deploy to Wasmer](https://img.shields.io/badge/Deploy%20to-Wasmer-171717?logo=wasmer&logoColor=white)](https://wasmer.io/apps/create?github=le0pard%2Fpgtune)
+
+To host your own copy (for example, an internal instance), fork this repository and import your fork on Wasmer Edge. The import reads the repository to build it; it does not copy it into your GitHub account. The `Anybuild` file is read only by Wasmer's builder: it runs `yarn build` with the committed yarn settings and serves the static `dist` directory. If the import page shows a different preset, select node-static (static Node build). Canonical links come from `SITE_URL` in `src/app/pageMeta.js`, so change it (and `public/CNAME`) for a copy on another domain.
+
 ## Contributing
 
 1. Fork it
