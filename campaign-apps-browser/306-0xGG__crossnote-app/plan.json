{
    "provider": "node-static",
    "config": {
        "name": "flat_0xGG__crossnote-app",
        "commands": {
            "install": "pnpm install",
            "build": "pnpm run build",
            "start": "static-web-server --root=/opt/static_app --log-level=info --port=8080"
        },
        "static_dir": "dist",
        "edgejs_enable": true,
        "edgejs_precompile": true,
        "node_package_manager": "pnpm",
        "node_framework": "vite",
        "node_server": "node",
        "node_build_command": "pnpm run build",
        "pnpm_version": "11.17.0",
        "node_remove_native_binaries": true,
        "node_install_inputs": [
            "package.json"
        ],
        "node_package_name": "crossnote"
    },
    "services": []
}