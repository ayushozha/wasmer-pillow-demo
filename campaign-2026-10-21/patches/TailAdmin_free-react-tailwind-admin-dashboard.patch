From 90bd26facd5e698bb3e1f0fa7cf8a2bb22e5f826 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 22 Oct 2026 06:14:02 +0000
Subject: [PATCH] docs: add Wasmer Edge deploy option

Add a root Anybuild file (generated by Anybuild 0.33.0) whose only edit is
static_redirects_config: static-web-server [[advanced.rewrites]] rules that
serve /index.html for each client-side route in src/App.tsx, with or
without a trailing slash. The rules use no wildcards, so unknown paths and
missing assets still return 404. Add a Deploy section to the README with
the Wasmer badge and fork-first import guidance.
---
 Anybuild  | 84 +++++++++++++++++++++++++++++++++++++++++++++++++++++++
 README.md | 12 ++++++++
 2 files changed, 96 insertions(+)
 create mode 100644 Anybuild

diff --git a/Anybuild b/Anybuild
new file mode 100644
index 0000000..05c0f5c
--- /dev/null
+++ b/Anybuild
@@ -0,0 +1,84 @@
+# Generated by Anybuild v0.33.0 — https://anybuild.run
+# This file is yours to edit: add steps or override the serve below.
+
+load("//anybuild/tools:node_static.bzl", "nodestatic_build", "nodestatic_config", "nodestatic_serve")
+
+config = nodestatic_config(
+    schema = 1,
+    sws_version = "2.38.0",
+    static_dir = "dist",
+    node_package_manager = "npm",
+    node_framework = "vite",
+    node_server = "node",
+    node_version = "24",
+    npm_version = "11",
+    # static-web-server config: serve index.html for the client-side routes in src/App.tsx.
+    static_redirects_config = """# SPA routes from src/App.tsx, each with and without a trailing slash. No wildcards,
+# so unknown paths and missing assets stay 404.
+[advanced]
+
+[[advanced.rewrites]]
+source = "{/profile,/profile/}"
+destination = "/index.html"
+
+[[advanced.rewrites]]
+source = "{/calendar,/calendar/}"
+destination = "/index.html"
+
+[[advanced.rewrites]]
+source = "{/blank,/blank/}"
+destination = "/index.html"
+
+[[advanced.rewrites]]
+source = "{/form-elements,/form-elements/}"
+destination = "/index.html"
+
+[[advanced.rewrites]]
+source = "{/basic-tables,/basic-tables/}"
+destination = "/index.html"
+
+[[advanced.rewrites]]
+source = "{/alerts,/alerts/}"
+destination = "/index.html"
+
+[[advanced.rewrites]]
+source = "{/avatars,/avatars/}"
+destination = "/index.html"
+
+[[advanced.rewrites]]
+source = "{/badge,/badge/}"
+destination = "/index.html"
+
+[[advanced.rewrites]]
+source = "{/buttons,/buttons/}"
+destination = "/index.html"
+
+[[advanced.rewrites]]
+source = "{/images,/images/}"
+destination = "/index.html"
+
+[[advanced.rewrites]]
+source = "{/videos,/videos/}"
+destination = "/index.html"
+
+[[advanced.rewrites]]
+source = "{/line-chart,/line-chart/}"
+destination = "/index.html"
+
+[[advanced.rewrites]]
+source = "{/bar-chart,/bar-chart/}"
+destination = "/index.html"
+
+[[advanced.rewrites]]
+source = "{/signin,/signin/}"
+destination = "/index.html"
+
+[[advanced.rewrites]]
+source = "{/signup,/signup/}"
+destination = "/index.html"
+""",
+)
+
+build = nodestatic_build(config)
+
+nodestatic_serve(config, build, name = "free-react-tailwind-admin-dashboard")
diff --git a/README.md b/README.md
index f3e9039..2138ad4 100644
--- a/README.md
+++ b/README.md
@@ -73,6 +73,18 @@ git clone https://github.com/TailAdmin/free-react-tailwind-admin-dashboard.git
     yarn dev
     ```
 
+## Deploy
+
+[![Deploy to Wasmer](https://img.shields.io/badge/Deploy%20to-Wasmer-171717?logo=wasmer&logoColor=white)](https://wasmer.io/apps/create?github=TailAdmin%2Ffree-react-tailwind-admin-dashboard)
+
+To host your own copy on Wasmer Edge, fork this repository first and import your fork. The button imports this public
+repository for a build; it does not copy the repository into your GitHub account.
+
+The root `Anybuild` file builds the app with `npm run build`, serves `dist/`, and serves `index.html` for the dashboard
+routes defined in `src/App.tsx` (such as `/profile` and `/calendar`), so those URLs also work when opened directly. When
+you add a route to `src/App.tsx`, add the same path to `static_redirects_config` in `Anybuild`. Other unknown URLs return
+404 when opened directly.
+
