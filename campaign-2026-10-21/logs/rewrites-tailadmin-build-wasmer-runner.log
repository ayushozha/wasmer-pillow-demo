annotations:
  anybuild.run/config:
    edgejs_enable: true
    edgejs_precompile: true
    name: free-react-tailwind-admin-dashboard
    node_build_command: npm run build
    node_framework: vite
    node_install_inputs:
    - package.json
    node_package_manager: npm
    node_package_name: tailadmin-react
    node_remove_native_binaries: true
    node_server: node
    npm_version: '11'
    static_dir: dist
    static_redirects_config: |
      # SPA routes from src/App.tsx, each with and without a trailing slash. No wildcards,
      # so unknown paths and missing assets stay 404.
