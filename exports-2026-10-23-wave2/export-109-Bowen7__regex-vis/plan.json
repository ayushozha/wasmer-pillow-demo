{
    "provider": "node-static",
    "config": {
        "name": "flat",
        "commands": {
            "install": "pnpm install",
            "build": "pnpm run build",
            "start": "static-web-server --root=/opt/static_app --log-level=info --config-file=/opt/static_config/sws.toml --port=8080"
        },
        "static_dir": "dist",
        "static_redirects_config": "\n[[advanced.rewrites]]\nsource = \"/samples\"\ndestination = \"/index.html\"\n\n[[advanced.rewrites]]\nsource = \"/samples/\"\ndestination = \"/index.html\"\n",
        "edgejs_enable": true,
        "edgejs_precompile": true,
        "node_package_manager": "pnpm",
        "node_framework": "vite",
        "node_server": "node",
        "node_build_command": "pnpm run build",
        "pnpm_version": "10",
        "node_remove_native_binaries": true,
        "node_install_inputs": [
            "package.json"
        ],
        "node_package_name": "regex-vis"
    },
    "services": []
}