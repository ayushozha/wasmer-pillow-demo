diff --git a/Anybuild b/Anybuild
new file mode 100644
index 0000000..9a8fef2
--- /dev/null
+++ b/Anybuild
@@ -0,0 +1,27 @@
+# Build the Vite app and serve only its static output on Wasmer.
+# /samples is a client-side route, so serve the app shell for it; other unknown paths stay 404.
+load("//anybuild/tools:node_static.bzl", "nodestatic_build", "nodestatic_config", "nodestatic_serve")
+
+config = nodestatic_config(
+    schema = 1,
+    static_redirects_config = """
+[[advanced.rewrites]]
+source = "/samples"
+destination = "/index.html"
+
+[[advanced.rewrites]]
+source = "/samples/"
+destination = "/index.html"
+""",
+    sws_version = "2.38.0",
+    static_dir = "dist",
+    node_package_manager = "pnpm",
+    node_framework = "vite",
+    node_server = "node",
+    node_version = "24",
+    pnpm_version = "10",
+)
+
+build = nodestatic_build(config)
+
+nodestatic_serve(config, build, name = "regex-vis")
