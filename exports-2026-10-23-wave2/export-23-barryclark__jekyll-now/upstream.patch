diff --git a/Anybuild b/Anybuild
new file mode 100644
index 0000000..cba8c82
--- /dev/null
+++ b/Anybuild
@@ -0,0 +1,17 @@
+# Build the Jekyll site and serve the generated _site folder on Wasmer.
+# The build step also adds the plugins _config.yml lists (jekyll-feed, jekyll-sitemap);
+# Jekyll 4 loads the Gemfile's :jekyll_plugins group, while the legacy `gems:` key is ignored.
+load("//anybuild/tools:jekyll.bzl", "jekyll_build", "jekyll_config")
+load("//anybuild/tools:staticfile.bzl", "staticfile_serve")
+
+config = jekyll_config(
+    schema = 1,
+    sws_version = "2.38.0",
+    ruby_version = "3.4.7",
+    jekyll_version = "4.3.0",
+    commands = {"build": "bundle add jekyll-feed jekyll-sitemap --group jekyll_plugins && jekyll build"},
+)
+
+build = jekyll_build(config)
+
+staticfile_serve(config, build, name = "jekyll-now")
