diff --git a/Anybuild b/Anybuild
new file mode 100644
index 0000000..d9ff28d
--- /dev/null
+++ b/Anybuild
@@ -0,0 +1,23 @@
+# Build the site the way `npm run build` does (webpack bundle, then Hugo into public/),
+# but with --baseURL=/ so links and assets resolve on the deployed host instead of the
+# baseURL in config.yml. Hugo is not an npm dependency, so it is added to the build.
+load("//anybuild/tools:node_static.bzl", "nodestatic_build", "nodestatic_config", "nodestatic_serve")
+
+config = nodestatic_config(
+    schema = 1,
+    sws_version = "2.38.0",
+    static_dir = "public",
+    node_package_manager = "npm",
+    node_build_command = "npm run build:webpack && hugo --destination=./public --baseURL=/",
+    node_version = "24",
+    npm_version = "11",
+)
+
+build = nodestatic_build(config)
+
+nodestatic_serve(
+    config,
+    build,
+    name = "flowbite-admin-dashboard",
+    build_pre = [use(dep("hugo", "0.153.2"))],
+)
