{
    "provider": "node-static",
    "config": {
        "name": "flat",
        "commands": {
            "install": "npm install",
            "build": "npm run build:webpack && hugo --destination=./public --baseURL=/",
            "start": "static-web-server --root=/opt/static_app --log-level=info --port=8080"
        },
        "static_dir": "public",
        "edgejs_enable": true,
        "edgejs_precompile": true,
        "node_package_manager": "npm",
        "node_server": "node",
        "node_build_command": "npm run build:webpack && hugo --destination=./public --baseURL=/",
        "npm_version": "11",
        "node_remove_native_binaries": true,
        "node_install_inputs": [
            "package.json"
        ],
        "node_package_name": "flowbite-admin-dashboard"
    },
    "services": []
}