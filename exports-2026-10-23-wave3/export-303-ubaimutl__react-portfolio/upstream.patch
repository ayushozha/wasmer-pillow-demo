diff --git a/Anybuild b/Anybuild
new file mode 100644
index 0000000..cd0a84c
--- /dev/null
+++ b/Anybuild
@@ -0,0 +1,34 @@
+# Wasmer serves the site from the domain root, so build with Vite's --base=/ instead of
+# the GitHub Pages base in vite.config.js (npm run deploy is unchanged).
+# /about, /portfolio and /contact are client-side routes: serve the app shell for exactly
+# those paths so they also work when opened directly. Other unknown paths stay 404.
+load("//anybuild/tools:node_static.bzl", "nodestatic_build", "nodestatic_config", "nodestatic_serve")
+
+config = nodestatic_config(
+    schema = 1,
+    static_redirects_config = """
+[[advanced.rewrites]]
+source = "/about"
+destination = "/index.html"
+
+[[advanced.rewrites]]
+source = "/portfolio"
+destination = "/index.html"
+
+[[advanced.rewrites]]
+source = "/contact"
+destination = "/index.html"
+""",
+    sws_version = "2.38.0",
+    static_dir = "dist",
+    node_package_manager = "npm",
+    node_framework = "vite",
+    node_server = "node",
+    node_build_command = "npm run build -- --base=/",
+    node_version = "24",
+    npm_version = "11",
+)
+
+build = nodestatic_build(config)
+
+nodestatic_serve(config, build, name = "react-portfolio")
