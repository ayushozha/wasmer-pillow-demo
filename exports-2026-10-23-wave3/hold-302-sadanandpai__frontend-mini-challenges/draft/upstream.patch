diff --git a/Anybuild b/Anybuild
new file mode 100644
index 00000000..d1f4c44f
--- /dev/null
+++ b/Anybuild
@@ -0,0 +1,23 @@
+# Build and serve configuration for Wasmer (https://anybuild.run).
+# The apps are built with the `/frontend-mini-challenges/` base path used on
+# GitHub Pages, so the assembled `dist` folder is served under that path and
+# `/` redirects to it.
+
+load("//anybuild/tools:node_static.bzl", "nodestatic_build", "nodestatic_config", "nodestatic_serve")
+
+config = nodestatic_config(
+    schema = 1,
+    sws_version = "2.38.0",
+    static_dir = "wasmer-site",
+    node_package_manager = "npm",
+    node_server = "node",
+    node_version = "24",
+    npm_version = "11",
+    node_install_requires_all_files = True,
+    node_build_command = "npm run build && npm run copy-to-dist && rm -rf wasmer-site && mkdir wasmer-site && cp -R dist wasmer-site/frontend-mini-challenges",
+    static_redirects_config = "[[advanced.redirects]]\nsource = \"/\"\ndestination = \"/frontend-mini-challenges/\"\nkind = 302\n",
+)
+
+build = nodestatic_build(config)
+
+nodestatic_serve(config, build, name = "frontend-mini-challenges")
diff --git a/README.md b/README.md
